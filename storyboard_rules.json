    "minimum_change_gap": 3.0,
    "long_change_target_seconds": 7.0,
    "preferred_cut_score": 2.0,
    "fallback_cut_score": 1.0,
    "pause_seconds": 0.3,
    "strong_pause_seconds": 0.55,
    "broll_insert_max_seconds": 4.0,
    "motion_zoom": 0.08,
