      "opinion": -2,
      "emotion": -2,
      "question": -2,
      "transition": -2,
      "summary": -2,
      "abstract": -1,
      "quote": 0,
      "other": 0
    },
    "searchable_visual_subject": 2
  },
  "thresholds": {
    "broll": 3,
    "optional_min": 0,
    "optional_max": 2,
    "aroll": -1
