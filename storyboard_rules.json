      "clause_end": 2.0,
      "sentence_end": 4.0,
      "pause": 2.0,
      "strong_pause": 5.0,
      "transition": 4.0,
      "viewpoint": 4.0,
      "semantic_change": 3.0,
      "subject_change": 2.0
